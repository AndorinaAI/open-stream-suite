# Plantilla de configuración de Open Stream Suite (copia este archivo a .env)
# Credenciales de tu aplicación de Twitch (https://dev.twitch.tv/console/apps)
TWITCH_CLIENT_ID=tu_client_id_aqui
TWITCH_CLIENT_SECRET=tu_client_secret_aqui
TWITCH_REDIRECT_URI=http://localhost:8080/callback
SERVER_PORT=8080

# Red: por defecto el servidor sólo escucha en tu propio equipo (recomendado).
# Para controlar la suite desde un deck conectado a OTRO equipo de tu red local,
# descomenta SERVER_HOST y define una clave larga en DECK_TOKEN.
# SERVER_HOST=0.0.0.0
# DECK_TOKEN=cambia_esto_por_una_clave_larga_y_aleatoria
